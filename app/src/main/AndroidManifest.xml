<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications about installs and updates; the module also grants it when it installs the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The periodic update check stays scheduled across restarts, and waits for Wi-Fi. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The terminal's sessions keep running while it is closed, with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The Backups tab lists the installed apps to back up by hand, with their names. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Google's sign-in page, for the Google Play account (the engine, as root, reaches the network by itself). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The apps that open a folder (the Files app, file managers), for Open config folder. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Nixup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The terminal: root's shell in Nixup's view, with the config's Nix packages. -->
        <activity
            android:name=".terminal.TerminalActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:label="@string/terminal"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Google's sign-in page, for the account Google Play's apps come with. -->
        <activity
            android:name=".GoogleSignInActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode"
            android:exported="false"
            android:label="@string/google_sign_in_title"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".terminal.TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Terminal sessions the user started, kept running while the terminal is closed" />
        </service>

        <!-- What the module's engine (as root) tells: not exported, so no other app can. -->
        <receiver
            android:name=".EventsReceiver"
            android:exported="false" />

        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".BackupJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
